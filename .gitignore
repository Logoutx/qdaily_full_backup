.DS_Store
__pycache__/
*.pyc
.venv/
venv/

# Source clone (read-only mirror of qdaily_backup; not committed)
source/

# Stage outputs that are large or regenerable
cache/
public/

# Asset images: kept separately depending on size — see RPD §5
# assets/  # uncomment if assets get split to a sibling repo

# Logs
data/failures.jsonl
data/*.log
data/preview_*.html

# Pagefind binary (downloaded by tools/install_pagefind.sh, ~50 MB)
bin/

# Local-only runtime state for the fetcher 48/48 cycle (each Mac has its own
# anchor + PID — see tools/fetcher_cycle.sh)
data/fetcher_cycle_state
data/fetcher.pid

# Internal handoff / agent-scratch documents — not part of the website
HANDOFF.md

# Planning, exploration, and error-log outputs — not consumed by render.py.
# These are working artifacts from recovery sessions; the live site doesn't
# need them and they bloat the repo as the project grows.
data/cdx_*.json
data/douban_index.jsonl
data/douban_misses.jsonl
data/douban_notes.jsonl
data/long_douban_matches.jsonl
data/long_missing_targets.jsonl
data/qdaily_recoverable_gaps.jsonl
data/xsj_full_targets.jsonl
data/xsj_partial_targets.jsonl
data/cdt_matches.tsv
data/extract_errors.jsonl
data/inventory_errors.tsv
data/douban_new_notes.json
data/douban_new_matches.tsv
data/douban_notes_scraped.json
data/douban_fuzzy_matches.tsv
data/douban_fuzzy_scraped.json

# Transient cache for Douban recovery (~280 MB) — see tools/fetch_douban_batch.py
.douban_cache/

# Wayback submission progress (resumable cursor, regenerated)
data/wayback_submitted.txt

# archive.org S3 keys for Wayback submission (secret, never commit)
data/.wayback_s3
data/wayback.log

# downscaled caption thumbnails (regenerated, local)
data/caption_thumbs/
